# Copiar como .env (no se versiona) y reemplazar con la cadena de MongoDB Atlas.
MONGO_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/usuarios_db?retryWrites=true&w=majority
PORT=3000
# Llave para firmar los JWT (HS256). Generar una propia, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<64 caracteres hexadecimales aleatorios>
# Opcional: usuario de demostración que se crea con npm run crear-usuario (y que usa la colección de Postman).
DEMO_USER_EMAIL=admin@empleados.local
DEMO_USER_PASSWORD=<contraseña de al menos 6 caracteres>
